# Which provider answers chats and extracts facts: "anthropic", "openai" or "ollama" (local, no key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults live in src/config.py)
CHAT_MODEL=
MEMORY_MODEL=
DATA_DIR=
OLLAMA_BASE_URL=

# Stop mem0 from sending usage telemetry
MEM0_TELEMETRY=False
